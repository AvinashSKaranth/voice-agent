{
  "name": "voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first voice desktop agent (BRD v0.3)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "pnpm install",
    "dev:agent": "pnpm --filter @voice-agent/agent dev",
    "dev:desktop": "pnpm --filter @voice-agent/desktop dev",
    "build": "pnpm -r build",
    "build:agent": "pnpm --filter @voice-agent/agent build",
    "test": "pnpm -r test",
    "test:agent": "pnpm --filter @voice-agent/agent test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
